# Your Anthropic API key (https://console.anthropic.com/settings/keys).
# EXPO_PUBLIC_ vars are bundled into the app — fine for a personal build only.
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# Optional: point the app at your own proxy that adds the key server-side
# (leave the key above empty in that case).
# EXPO_PUBLIC_ANTHROPIC_BASE_URL=https://your-proxy.example.com
